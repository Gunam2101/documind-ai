APP_ENV=development
PROJECT_NAME="DocuMind AI"

# Database
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@[::1]:5432/documind



# JWT Configuration
JWT_SECRET=super_secret_jwt_key_documind_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & Embeddings
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (faiss | pinecone)
VECTOR_STORE=faiss
PINECONE_API_KEY=
PINECONE_INDEX_NAME=documind-index

# OCR Settings (Tesseract executable path on Windows / Linux)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TEXT_THRESHOLD=50

# Storage & Uploads
STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=25

# RAG Defaults
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# CORS
FRONTEND_URL=http://localhost:5173
