# DocuMind AI Root Environment Template

# Backend Settings
APP_ENV=development
PROJECT_NAME="DocuMind AI"

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./documind.db

# Security & JWT Secrets
JWT_SECRET=super_secret_jwt_key_documind_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Store (faiss | pinecone)
VECTOR_STORE=faiss
PINECONE_API_KEY=
PINECONE_INDEX_NAME=documind-index

# Storage & Upload Limits
STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=25

# RAG Hyperparameters
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:8000/api
